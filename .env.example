# Copy this file to .env and fill in real values. Never commit .env.

# JWKS endpoint used to verify access token signatures
KEY_SOURCE=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# Expected "iss" claim of the access token
ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Access token to validate (for local testing only)
ACCESS_TOKEN=<your-access-token>
